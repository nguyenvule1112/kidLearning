# Giọng đọc mặc định (cũng là giọng được đóng gói khi build để chạy online):
#   edge:vi-VN-HoaiMyNeural   (nữ, giọng Việt bản địa của Microsoft, MIỄN PHÍ, không cần key)  <- khuyên dùng
#   edge:vi-VN-NamMinhNeural  (nam)
#   gemini:Leda / gemini:Aoede / gemini:Kore / gemini:Puck   (cần GEMINI_API_KEY bên dưới)
TTS_VOICE=edge:vi-VN-HoaiMyNeural

# Tốc độ giọng Microsoft (âm là chậm hơn), ví dụ -8% hoặc -15%
EDGE_TTS_RATE=-8%

# Tùy chọn: khóa Gemini, lấy miễn phí tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
